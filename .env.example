# ==============================================================================
# KeyCraft 3D - Environment Variables Configuration Template
# ==============================================================================
# Sao chép file này thành .env.local (cho dev) hoặc .env (cho Docker/Production):
# cp .env.example .env.local

# ------------------------------------------------------------------------------
# 1. Ứng dụng & Môi trường (App & Environment)
# ------------------------------------------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. AI & LLM Engine (Google Gemini qua Vercel AI SDK)
# ------------------------------------------------------------------------------
# Lấy API Key miễn phí tại Google AI Studio: https://aistudio.google.com/
GOOGLE_GENERATIVE_AI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 3. Cơ sở dữ liệu (PostgreSQL 17 + pgvector extension)
# ------------------------------------------------------------------------------
# Cấu hình container PostgreSQL hoặc Cloud DB (Supabase/Neon/Docker local)
POSTGRES_USER=keycraft
POSTGRES_PASSWORD=keycraft_secret
POSTGRES_DB=keycraft_db
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# Connection string sử dụng trong Drizzle ORM
DATABASE_URL=postgresql://keycraft:keycraft_secret@localhost:5432/keycraft_db

# ------------------------------------------------------------------------------
# 4. Bộ nhớ đệm & Giới hạn tần suất gọi API (Redis)
# ------------------------------------------------------------------------------
# Cấu hình Redis instance (Docker local hoặc Upstash Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# Cấu hình Rate Limiting (Số lượt gọi tối đa / Khoảng thời gian tính bằng giây)
AI_RATE_LIMIT_MAX_REQUESTS=10
AI_RATE_LIMIT_WINDOW_SECONDS=60

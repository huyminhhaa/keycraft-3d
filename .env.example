# ==============================================================================
# KeyCraft 3D - Environment Variables Configuration Template
# ==============================================================================
# Sao chép file này thành .env.local (cho dev) hoặc .env (cho Docker/Production):
# cp .env.example .env.local

# ------------------------------------------------------------------------------
# 1. Ứng dụng & Môi trường (App & Environment)
# ------------------------------------------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. Xác thực & Bảo mật (Authentication, JWT & Anti-Brute-Force Security)
# ------------------------------------------------------------------------------
# Khóa bí mật ký JWT Token (tạo bằng: openssl rand -base64 48)
# BẮT BUỘC thay trên production: thiếu, ngắn hơn 32 ký tự hoặc giữ nguyên giá trị mẫu dưới đây
# -> server ném 'Fatal Security Error' và không khởi động (src/instrumentation.ts).
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_minimum_32_characters_here
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cấu hình chống tấn công dò mật khẩu (Anti Brute-force & CAPTCHA)
AUTH_MAX_FAILED_ATTEMPTS=3
AUTH_LOCKOUT_SECONDS=900

# Khóa CAPTCHA (Cloudflare Turnstile / hCaptcha)
NEXT_PUBLIC_CAPTCHA_SITE_KEY=your_captcha_site_key
CAPTCHA_SECRET_KEY=your_captcha_secret_key

# OAuth Providers (Tùy chọn)
AUTH_GOOGLE_ID=your_google_client_id
AUTH_GOOGLE_SECRET=your_google_client_secret
AUTH_GITHUB_ID=your_github_client_id
AUTH_GITHUB_SECRET=your_github_client_secret

# ------------------------------------------------------------------------------
# 3. AI & LLM Engine (Google Gemini qua Vercel AI SDK)
# ------------------------------------------------------------------------------
# Lấy API Key miễn phí tại Google AI Studio: https://aistudio.google.com/
GOOGLE_GENERATIVE_AI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# ------------------------------------------------------------------------------
# 4. Cơ sở dữ liệu (PostgreSQL 17 + pgvector extension)
# ------------------------------------------------------------------------------
# Cấu hình container PostgreSQL hoặc Cloud DB (Supabase/Neon/Docker local)
POSTGRES_USER=keycraft
POSTGRES_PASSWORD=keycraft_secret
POSTGRES_DB=keycraft_db
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# Connection string sử dụng trong Drizzle ORM
DATABASE_URL=postgresql://keycraft:keycraft_secret@localhost:5432/keycraft_db

# ------------------------------------------------------------------------------
# 5. Bộ nhớ đệm & Giới hạn tần suất gọi API (Redis)
# ------------------------------------------------------------------------------
# Cấu hình Redis instance (Docker local hoặc Upstash Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# Hạn mức chính nằm trong src/lib/security/rateLimit.ts (RATE_LIMITS): /api/chat 15 tin/phút (thành viên),
# 5 tin/phút (khách); đăng ký 5 lượt/10 phút/IP; lưu build 10 lượt/phút. Hai biến dưới chỉ còn dùng cho checkAIRateLimit.
AI_RATE_LIMIT_MAX_REQUESTS=10
AI_RATE_LIMIT_WINDOW_SECONDS=60
